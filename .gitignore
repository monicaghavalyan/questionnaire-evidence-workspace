# Secrets - never commit. Only the variable NAMES are recorded, in ai-workflow/.env.example
.env
.env.*
!.env.example

# Regenerable: rebuild with `python -m app.loader --reset`
*.sqlite
*.sqlite-wal
*.sqlite-shm

# NOTE: cache/ is deliberately NOT ignored. The recorded model responses are what make
# MODEL_MODE=replay work for a reviewer with no API key, so they are part of the submission.

__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.DS_Store
.idea/
.vscode/
