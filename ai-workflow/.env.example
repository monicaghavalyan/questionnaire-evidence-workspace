# Environment variable NAMES used by this project. Values here are defaults or blank.
# The app reads the process environment only (it does not load .env files), so export
# these in your shell. Never commit a real key.

# Secret - only needed for MODEL_MODE=live.
MODEL_API_KEY=

# live | replay | stub. replay serves the recorded responses in cache/ and needs no key.
MODEL_MODE=replay
MODEL_ID=claude-sonnet-4-5
MODEL_TEMPERATURE=0
MODEL_MAX_TOKENS=1024

# Optional path overrides.
MODEL_CACHE=cache
APP_DB=data/workspace.sqlite

# 1 = an answer is only accepted if its cited passages cover the question's content words.
STRICT_COVERAGE=1
